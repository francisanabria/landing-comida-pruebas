---
import { client } from "../sanityClient.js";

const platos = await client.fetch(`*[_type == "plato"] | order(order asc) {
  nombre,
  descripcion,
  precio,
  "imageUrl": image.asset->url,
  "countryIconUrl": countryIcon.asset->url,
  vegetarianOption,
  order
}`);

const bebidasPostres = await client.fetch(`*[_type == "bebidaPostre"] | order(order asc) {
  nombre,
  descripcion,
  precio,
  "imageUrl": image.asset->url
}`);
---
<section translate="yes" id="menu" class="py-20 bg-zinc-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 reveal">
            <h2 class="text-3xl md:text-4xl xl:text-5xl font-serif font-bold mb-4"><a href="/#menu"> Mamey Menü – Essen in Winterthur</a></h2>
            <div class="w-24 h-1 bg-emerald-500 mx-auto"></div>
            <p class="mt-4 text-zinc-400 max-w-2xl mx-auto">Qualität, Geschmack und Tradition in jedem Gericht.</p>
        </div>

        <!-- Carrusel Container -->
        <div class="relative px-0 md:px-12 reveal">
            <!-- Botones de navegación (visibles en desktop) -->
            <button id="prev-slide" class="absolute left-0 top-1/2 -translate-y-1/2 z-10 bg-emerald-600/80 hover:bg-emerald-600 text-white p-3 rounded-full shadow-lg backdrop-blur-sm transition-all hidden md:block hover:scale-110" aria-label="Anterior">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button id="next-slide" class="absolute right-0 top-1/2 -translate-y-1/2 z-10 bg-emerald-600/80 hover:bg-emerald-600 text-white p-3 rounded-full shadow-lg backdrop-blur-sm transition-all hidden md:block hover:scale-110" aria-label="Siguiente">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>

            <!-- Scroll Area -->
            <div id="menu-carousel" class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-8 [&::-webkit-scrollbar]:hidden" style="scrollbar-width: none; -ms-overflow-style: none;">
                
                {platos.map((plato) => (
                <div class="min-w-[85%] md:min-w-[350px] snap-center bg-zinc-800 rounded-xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-300 group">
                    <div class="overflow-hidden h-64">
                        <img 
                            src={plato.imageUrl} 
                            alt={plato.nombre} 
                            class="w-full h-full object-cover transform group-hover:scale-110 group-active:scale-110 transition duration-700"
                        />
                    </div>
                    <div class="p-6">
                        <h3 class="text-2xl font-serif font-bold text-emerald-100 mb-2">
                            {plato.countryIconUrl && <img src={plato.countryIconUrl} class="inline w-10 h-10 align-middle" alt="Bandera" /> }
                            {" " + plato.nombre}
                        </h3>
                        <p class="text-zinc-400 text-sm leading-relaxed">{plato.descripcion}</p>
                        <span class="font-bold text-shadow-amber-50 font-serif text-1xl "> {plato.precio} CHF</span>
                        {plato.vegetarianOption && (
                            <><br/><br/><span class=" text-shadow-amber-50 font-serif text-sm ">{plato.vegetarianOption && ("Vegetarische Option auf Anfrage")}</span></>
                        )}
                    </div>
                </div>
                ))}
                
            </div>
        </div>

    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 reveal">
            <h2 class="text-3xl md:text-4xl xl:text-5xl font-serif font-bold mb-4">Erfrischungen  &  Desserts</h2>
            <div class="w-24 h-1 bg-emerald-500 mx-auto"></div>
            <p class="mt-4 text-zinc-400 max-w-2xl mx-auto">Der süsse und erfrischende Begleiter zu deinem Essen.</p>
        </div>

        <!-- Carrusel Container 2-->
        <div class="relative px-0 md:px-12 reveal">
            <!-- Botones de navegación (visibles en desktop) -->
            <button id="prev-slide-dessert" class="absolute left-0 top-1/2 -translate-y-1/2 z-10 bg-emerald-600/80 hover:bg-emerald-600 text-white p-3 rounded-full shadow-lg backdrop-blur-sm transition-all hidden md:block hover:scale-110" aria-label="Anterior">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button id="next-slide-dessert" class="absolute right-0 top-1/2 -translate-y-1/2 z-10 bg-emerald-600/80 hover:bg-emerald-600 text-white p-3 rounded-full shadow-lg backdrop-blur-sm transition-all hidden md:block hover:scale-110" aria-label="Siguiente">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>

            <!-- Scroll Area -->
            <div id="dessert-carousel" class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-8 [&::-webkit-scrollbar]:hidden" style="scrollbar-width: none; -ms-overflow-style: none;">
                
                {bebidasPostres.map((item) => (
                <div class="min-w-[85%] md:min-w-[350px] snap-center bg-zinc-800 rounded-xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-300 group">
                    <div class="overflow-hidden h-64">
                        <img 
                            src={item.imageUrl} 
                            alt={item.nombre} 
                            class="w-full h-full object-cover transform group-hover:scale-110 group-active:scale-110 transition duration-700"
                        />
                    </div>
                    <div class="p-6">
                        <h3 class="text-2xl font-serif font-bold text-emerald-100 mb-2">{item.nombre}</h3>
                        <p class="text-zinc-400 text-sm leading-relaxed">{item.descripcion}</p>
                        <span class="font-bold text-shadow-amber-50 font-serif text-1xl "> {item.precio} CHF</span>
                    </div>
                </div>
                ))}
       

            </div>
        </div>

        <div class="text-center mt-12 reveal">
            <a href="https://wa.me/41765229399?" class="inline-block border border-emerald-500 text-emerald-500 hover:bg-emerald-500 hover:text-white px-8 py-3 rounded-full transition-colors uppercase tracking-wider text-sm font-bold">
                Individuelle Anfrage
            </a>
             <p translate="yes" class=" mt-2 text-lg md:text-xl text-gray-200 mb-10 max-w-2xl mx-auto ">
                Gerne bereiten wir auch andere lateinamerikanische Spezialitäten nach Wunsch zu</p>
        </div>
    </div>
</section>

<script>
    // Script del Carrusel
    const carousel = document.getElementById('menu-carousel');
    const prevBtn = document.getElementById('prev-slide');
    const nextBtn = document.getElementById('next-slide');

    if (carousel && prevBtn && nextBtn) {
        nextBtn.addEventListener('click', () => {
            carousel.scrollBy({ left: 350, behavior: 'smooth' });
        });
        prevBtn.addEventListener('click', () => {
            carousel.scrollBy({ left: -350, behavior: 'smooth' });
        });
    }

    // Script del Carrusel Postres (NUEVO)
    const carouselDessert = document.getElementById('dessert-carousel');
    const prevBtnDessert = document.getElementById('prev-slide-dessert');
    const nextBtnDessert = document.getElementById('next-slide-dessert');

    if (carouselDessert && prevBtnDessert && nextBtnDessert) {
        nextBtnDessert.addEventListener('click', () => {
            carouselDessert.scrollBy({ left: 350, behavior: 'smooth' });
        });
        prevBtnDessert.addEventListener('click', () => {
            carouselDessert.scrollBy({ left: -350, behavior: 'smooth' });
        });
    }
</script>

<style>
    /* Protección global para todas las imágenes dentro de la sección de menú */
    #menu img {
        pointer-events: none;
        user-select: none;
        -webkit-user-select: none;
    }
</style>