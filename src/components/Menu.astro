                        <img 
                            src="/images/milanesa.jpg" 
                            alt="Ceviche Mamey" 
                            class="w-full h-full object-cover transform group-hover:scale-110 group-active:scale-110 transition duration-700"
                        />
                    </div>
                    <div class="p-6 ">
                        
                        <h3 class="text-2xl font-serif font-bold text-emerald-100 mb-2"><img src="/images/arg.png" class="inline w-10 h-10 align-middle" />  Milanesa napolitana</h3>
                        <p class="text-zinc-400 text-sm leading-relaxed text-left">Paniertes Rindsschnitzel aus zartem, dünn geschnittenem Rindfleisch
                        oder Pouletbrust-Schnitzel aus saftiger Hähnchenbrust.
                        Belegt mit aromatischer Tomatensauce und goldbraun überbackenem Käse.
                        Serviert nach Wahl mit Crispy Potato Sticks oder frischem Salat.
                        Ein klassischer Genuss aus Argentinien – zart und voller Geschmack.
                        </p>
                             <p class="font-bold text-shadow-amber-50 font-serif text-1xl"> 36 CHF</p>
                    </div>
                </div>
                
                <!-- Plato 5 -->
                <div class="min-w-[85%] md:min-w-[350px] snap-center bg-zinc-800 rounded-xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-300 group">
