---
import { client } from "../sanityClient.js";

const horarios = await client.fetch(`*[_type == "horario"] | order(order asc) {
  title,
  tabId,
  details,
  isPrimary,
  icon
}`);
---
<section id="horario-menu" class="bg-white py-10 px-4">
  <div class="max-w-4xl mx-auto reveal">
    
    <h2 class="text-center text-2xl font-bold text-[#004d40] mb-8">So bestellst du bei Mamey</h2>
    <p class="text-center text-1xl font-semibold text-[#333434] mb-8">👇 Antippen für mehr Infos</p>

    <!-- Mobile Buttons - Dynamic -->
    <div class="flex justify-center gap-4 sm:gap-8 md:hidden mb-10">
      {horarios.map(horario => (
        <div class="flex flex-col items-center gap-2">
          <button data-target={horario.tabId} aria-label={`${horario.title} anzeigen`} class="tab-toggle-btn group relative flex items-center justify-center w-16 h-16 bg-emerald-600 text-white rounded-full shadow-xl shadow-emerald-600/20 transition-all duration-300 hover:bg-emerald-700 hover:-translate-y-1 focus:outline-none active:scale-95">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 mx-auto">
              <path stroke-linecap="round" stroke-linejoin="round" d={horario.icon} />
            </svg>
            <div class="absolute -bottom-1 -right-1 w-6 h-6 bg-white text-emerald-600 rounded-full flex items-center justify-center shadow-sm border border-emerald-100 transition-transform duration-300 group-[.active]:rotate-180">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </div>
          </button>
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">{horario.title}</span>
        </div>
      ))}
    </div>

    <!-- Desktop Cards - Dynamic -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {horarios.map(horario => (
        <div 
          id={horario.tabId} 
          class:list={[
            "hidden md:block p-6 rounded-2xl shadow-lg text-center",
            horario.isPrimary 
              ? "bg-emerald-600 border-4 border-emerald-500" 
              : "bg-zinc-800 border-4 border-emerald-600"
          ]}
        >
          <div class="hidden md:flex justify-center mb-4 text-white">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12">
              <path stroke-linecap="round" stroke-linejoin="round" d={horario.icon} />
            </svg>
          </div>
          <div class:list={[
            "hidden md:block w-16 h-1 mx-auto mb-4 rounded-full",
            horario.isPrimary ? "bg-emerald-200/30" : "bg-emerald-500"
          ]}></div>
          <h3 class="font-bold text-white text-lg mb-4">{horario.title}</h3>
          <ul class="text-sm text-emerald-50 space-y-2 text-left">
            {horario.details.map(detail => (
              <li>{detail}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const buttons = document.querySelectorAll('.tab-toggle-btn');
  const tabIds = Array.from(buttons).map(btn => btn.getAttribute('data-target'));

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      const targetContent = document.getElementById(targetId);

      if (targetContent) {
        // Verificar si está oculto actualmente
        const isHidden = targetContent.classList.contains('hidden');

        // 1. Ocultar todos los tabs primero
        tabIds.forEach(id => {
          document.getElementById(id)?.classList.add('hidden');
        });
        
        // Resetear estado visual de todos los botones
        buttons.forEach(b => {
            b.classList.remove('active', 'ring-4', 'ring-emerald-100');
        });

        // 2. Si estaba oculto, mostrarlo (si estaba visible, el paso 1 ya lo ocultó, logrando el toggle)
        if (isHidden) {
          targetContent.classList.remove('hidden');
          btn.classList.add('active', 'ring-4', 'ring-emerald-100');
        }
      }
    });
  });
</script>