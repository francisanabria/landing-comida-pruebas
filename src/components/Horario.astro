<section id="como-pedir" class="relative overflow-hidden bg-white py-14 sm:py-16">
  <!-- paper texture -->
  <div class="pointer-events-none absolute inset-0 bg-[url('/img/paper-texture.jpg')] bg-cover bg-center opacity-90"></div>

  <!-- soft emerald wash like the mock -->
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(16,185,129,.16),transparent_55%)]"></div>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,rgba(16,185,129,.12),transparent_60%)]"></div>

  <!-- corner decorations -->
  <img src="/img/decor-palm-tl.png" alt="" class="pointer-events-none absolute -left-12 -top-12 hidden w-60 opacity-90 sm:block" />
  <img src="/img/decor-bowl-tr.png" alt="" class="pointer-events-none absolute -right-12 -top-10 hidden w-60 opacity-95 sm:block" />
  <img src="/img/decor-limes-bl.png" alt="" class="pointer-events-none absolute -left-16 -bottom-16 hidden w-72 opacity-95 sm:block" />
  <img src="/img/decor-palm-br.png" alt="" class="pointer-events-none absolute -right-14 -bottom-14 hidden w-72 opacity-90 sm:block" />

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- title + intro -->
    <header class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-semibold tracking-tight text-emerald-900 sm:text-4xl">
        <span class="mr-2">🌴</span>¿Cómo pedir en Mamey?
      </h2>

      <p class="mt-4 text-base leading-relaxed text-zinc-700 sm:text-lg">
        En Mamey Latin Soul Food te invitamos a vivir una experiencia auténtica de la cocina latinoamericana,
        donde el sabor, la tradición y el cariño se sienten en cada plato.
      </p>
    </header>

    <!-- layout: cards + phone (desktop) -->
    <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_360px] lg:items-start">
      <!-- cards -->
      <div class="grid gap-6 sm:grid-cols-2">
        <!-- shared card styles: "paper card" -->
        <!-- Card 1 -->
        <article class="rounded-2xl border border-emerald-100 bg-white/85 p-6 shadow-[0_10px_30px_rgba(0,0,0,.06)] backdrop-blur-sm">
          <div class="flex items-center gap-3">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 ring-1 ring-emerald-100">
              🗓
            </span>
            <h3 class="text-lg font-semibold text-emerald-900">Días de atención</h3>
          </div>

          <ul class="mt-4 space-y-2 text-zinc-800">
            <li class="flex items-start gap-2">
              <span class="mt-2 h-2 w-2 rounded-full bg-emerald-500"></span>
              <span>Miércoles a domingo</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-2 h-2 w-2 rounded-full bg-emerald-200"></span>
              <span>📌 Lunes y martes cerrado</span>
            </li>
          </ul>
        </article>

        <!-- Card 2 -->
        <article class="rounded-2xl border border-emerald-100 bg-white/85 p-6 shadow-[0_10px_30px_rgba(0,0,0,.06)] backdrop-blur-sm">
          <div class="flex items-center gap-3">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 ring-1 ring-emerald-100">
              🕘
            </span>
            <h3 class="text-lg font-semibold text-emerald-900">Horario para hacer pedidos</h3>
          </div>

          <div class="mt-4 space-y-3 text-zinc-800">
            <p class="flex items-center gap-2">
              <span class="mt-1 h-2 w-2 rounded-full bg-emerald-500"></span>
              <span><strong>09:00 – 15:00</strong> horas</span>
            </p>

            <p class="flex items-start gap-2 text-zinc-700">
              <span>⏳</span>
              <span>Pedidos con mínimo <strong class="text-zinc-900">2 horas</strong> de antelación</span>
            </p>

            <div class="rounded-xl border border-emerald-100 bg-emerald-50/70 p-4 text-sm leading-relaxed text-zinc-700">
              <p class="font-medium text-emerald-900">✨ Si el horario ya pasó, no dudes en escribirnos.</p>
              <p class="mt-1">En algunos casos es posible aceptar pedidos extra de último momento.</p>
            </div>
          </div>
        </article>

        <!-- Card 3 -->
        <article class="rounded-2xl border border-emerald-100 bg-white/85 p-6 shadow-[0_10px_30px_rgba(0,0,0,.06)] backdrop-blur-sm">
          <div class="flex items-center gap-3">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 ring-1 ring-emerald-100">
              🚚
            </span>
            <h3 class="text-lg font-semibold text-emerald-900">Horarios de entrega</h3>
          </div>

          <div class="mt-4 space-y-3 text-zinc-800">
            <p class="flex items-start gap-2"><span>🍽</span><span><strong>Servicio de almuerzo:</strong> 11:30 – 14:00 horas</span></p>
            <p class="flex items-start gap-2"><span>🌆</span><span><strong>Servicio de cena:</strong> 18:00 – 21:00 horas</span></p>
          </div>
        </article>

        <!-- Card 4 -->
        <article class="rounded-2xl border border-emerald-200 bg-emerald-50/75 p-6 shadow-[0_10px_30px_rgba(0,0,0,.06)] backdrop-blur-sm">
          <div class="flex items-center gap-3">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-white/80 ring-1 ring-emerald-100">
              📌
            </span>
            <h3 class="text-lg font-semibold text-emerald-900">Nuestro compromiso</h3>
          </div>

          <ul class="mt-4 space-y-2 text-zinc-800">
            <li class="flex gap-2"><span class="text-emerald-700">✔</span>Preparación bajo pedido</li>
            <li class="flex gap-2"><span class="text-emerald-700">✔</span>Sin servicio a la carta</li>
            <li class="flex gap-2"><span class="text-emerald-700">✔</span>Enfoque en frescura, sabor y presentación</li>
          </ul>

          <p class="mt-4 text-sm leading-relaxed text-zinc-700">
            Garantizamos una experiencia auténtica, cuidada y llena de sabor en cada pedido.
          </p>
        </article>
      </div>

      <!-- phone preview (desktop) -->
      <aside class="hidden lg:block">
        <div class="sticky top-10">
          <div class="mx-auto w-[340px] rounded-[2.25rem] border border-zinc-200 bg-white/80 p-3 shadow-[0_18px_50px_rgba(0,0,0,.12)] backdrop-blur">
            <div class="rounded-[1.9rem] border border-zinc-200 bg-[url('/img/paper-texture.jpg')] bg-cover bg-center">
              <div class="flex justify-center pt-3">
                <div class="h-1.5 w-16 rounded-full bg-zinc-200"></div>
              </div>

              <div class="px-5 pb-6 pt-4">
                <h4 class="text-center text-xl font-semibold text-emerald-900">🌴 ¿Cómo pedir en Mamey?</h4>
                <p class="mt-3 text-center text-sm leading-relaxed text-zinc-700">
                  Experiencia auténtica de la cocina latinoamericana.
                </p>

                <div class="mt-5 space-y-4">
                  <div class="rounded-2xl border border-emerald-100 bg-white/85 p-4 shadow-sm">
                    <p class="font-semibold text-emerald-900">🗓 Días de atención</p>
                    <p class="mt-2 text-sm text-zinc-800">Miércoles a domingo</p>
                    <p class="text-sm text-zinc-600">📌 Lunes y martes cerrado</p>
                  </div>

                  <div class="rounded-2xl border border-emerald-100 bg-white/85 p-4 shadow-sm">
                    <p class="font-semibold text-emerald-900">🕘 Pedidos</p>
                    <p class="mt-2 text-sm text-zinc-800"><strong>09:00 – 15:00</strong></p>
                    <p class="mt-1 text-sm text-zinc-700">⏳ Mínimo 2 horas</p>
                    <p class="mt-2 text-sm text-zinc-700">✨ Si ya pasó el horario, escríbenos.</p>
                  </div>

                  <div class="rounded-2xl border border-emerald-100 bg-white/85 p-4 shadow-sm">
                    <p class="font-semibold text-emerald-900">🚚 Entregas</p>
                    <p class="mt-2 text-sm text-zinc-800">🍽 11:30 – 14:00</p>
                    <p class="text-sm text-zinc-800">🌆 18:00 – 21:00</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <p class="mt-4 text-center text-xs text-zinc-500">Vista móvil</p>
        </div>
      </aside>
    </div>

    <!-- mobile hint -->
    <div class="mt-10 lg:hidden text-center text-xs text-zinc-500">
      En móvil las tarjetas van en una columna.
    </div>
  </div>
</section>