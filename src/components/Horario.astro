<script>
  const buttons = document.querySelectorAll('.tab-toggle-btn');
  const tabIds = ['tab-calendar', 'tab-clock', 'tab-delivery'];

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      const targetContent = document.getElementById(targetId);

      if (targetContent) {
        // Verificar si está oculto actualmente
        const isHidden = targetContent.classList.contains('hidden');

        // 1. Ocultar todos los tabs primero
        tabIds.forEach(id => {
          document.getElementById(id)?.classList.add('hidden');
        });
        
        // Resetear estado visual de todos los botones
        buttons.forEach(b => {
            b.classList.remove('active', 'ring-4', 'ring-emerald-100');
        });

        // 2. Si estaba oculto, mostrarlo (si estaba visible, el paso 1 ya lo ocultó, logrando el toggle)
        if (isHidden) {
          targetContent.classList.remove('hidden');
          btn.classList.add('active', 'ring-4', 'ring-emerald-100');
        }
      }
    });
  });
</script>