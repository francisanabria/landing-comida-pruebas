---
---
  <!-- <section translate="yes" id="pilosophie" class="py-20 bg-white rounded-[50px]">-->
    <div id="pilosophie"  class="scroll-mt-32 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-12 items-center">
            <div class="order-2 xl:order-1 reveal">
                <div class="relative">
                    <!-- Imagen decorativa -->
                    <div class="absolute -top-4 -left-4 w-24 h-24  bg-emerald-500 rounded-full z-0"></div>
                    <img 
                        src="/images/ritmo.jpeg" 
                        alt="Chef cocinando" 
                        class="relative z-10 w-full h-auto xl:h-[500px] rounded-lg shadow-2xl object-cover pointer-events-none select-none"
                        />
                
                    <div class="absolute -bottom-4 -right-4 w-32 h-32 bg-emerald-500 rounded-lg z-0"></div>
                </div>
            </div>
            <div class="order-1 xl:order-2 reveal">
                <h3 class="text-emerald-600 font-bold tracking-widest uppercase text-sm mb-2">Unsere Philosophie</h3>
                <h2 class="text-3xl md:text-4xl xl:text-5xl font-serif font-bold text-zinc-900 mb-6">Der Rhythmus unserer Kultur auf deinem Tisch</h2>
                <p class="text-lg text-zinc-900 mb-3 leading-relaxed">
                    In Lateinamerika ist<span class="font-bold text-zinc-800"> Mamey</span>
                    
                    mehr als nur eine Frucht,
                    Sie ist Erinnerung, Begegnung und Rhythmus.
                    Ihre intensive Süsse bewahrt die Wärme gemeinsamer Momente,
                    die Musik, die durch offene Türen strömt,
                    und das Lachen, das an einem liebevoll gedeckten Tisch entsteht.
                </p>
                <div id="pilosophie-medium" class="hidden md:block">
                    <p class="text-lg text-zinc-900 mb-3 leading-relaxed">
                     Deshalb trägt unser Projekt den Namen Mamey.
                    Wir bringen diesen Geist der Verbundenheit in jedes Gericht,
                    indem wir Tradition mit einem modernen Touch verbinden:
                    authentisch, raffiniert und voller Seele.</p>
                </div>
                <div id="pilosophie-more" class="hidden">
                    <p class="text-lg text-zinc-900 mb-3 leading-relaxed">
                    Mamey steht für Geschmack, Zuhause und lateinamerikanisches Erbe,
                    serviert mit Liebe und dem Rhythmus unserer Kultur.</p>
                </div>
                <button id="pilosophie-btn" class="text-emerald-600 font-semibold mt-2 hover:underline focus:outline-none">
                    Mehr anzeigen
                </button>
            </div>
        </div>
    </div>
    <script>
        const btn = document.getElementById('pilosophie-btn');
        const moreText = document.getElementById('pilosophie-more');
        const mediumText = document.getElementById('pilosophie-medium');
        btn?.addEventListener('click', () => {
            if (moreText?.classList.contains('hidden')) {
                moreText.classList.remove('hidden');
                mediumText?.classList.remove('hidden');
                btn.textContent = 'Weniger anzeigen';
            } else {
                moreText?.classList.add('hidden');
                mediumText?.classList.add('hidden');
                btn.textContent = 'Mehr anzeigen';
                btn.closest('.reveal')?.querySelector('h2')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });
    </script>
  <!-- </section>-->