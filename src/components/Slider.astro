---
// src/components/Slider.astro
const slides = [
  { img: '/images/g1.jpeg', title: 'CHAMONIX', sub: 'FRANCE' },
  { img: '/images/g2.jpeg', title: 'YOSEMITE', sub: 'USA' },
  { img: '/images/g3.jpeg', title: 'ALPS', sub: 'SWISS' },
  { img: '/images/g4.jpeg', title: 'CHAMONIX', sub: 'FRANCE' },
  { img: '/images/g5.jpeg', title: 'YOSEMITE', sub: 'USA' },
  { img: '/images/g6.jpeg', title: 'ALPS', sub: 'SWISS' },
];
---
<section translate="yes" id="galerie" class="py-15 bg-zinc-900 relative overflow-hidden">
			<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12 reveal">
					<h2 class="text-4xl md:text-5xl font-serif font-bold text-white">Geschichten & Momente</h2>
				</div>
<div class="swiper mySwiper !py-10 md:!py-20 bg-transparent h-auto relative rounded-3xl overflow-hidden">
  <!-- Background Watermark inside swiper container -->
  <div id="slider-bg" class="absolute inset-0 bg-cover bg-center opacity-60 transition-all duration-700 blur-sm z-0"></div>

  <div class="swiper-wrapper z-10">
    {slides.map((slide) => (
      <div class="swiper-slide !w-72 !h-[25rem] md:!w-80 md:!h-[30rem] relative group shadow-2xl rounded-xl overflow-hidden">
        <img src={slide.img} class="w-full h-full object-cover pointer-events-none select-none" alt={slide.title} />
        
        <div class="absolute inset-0 bg-black/20 flex flex-col items-center justify-center text-white text-center">
          <h2 class="text-3xl font-serif tracking-[0.3em] uppercase">{slide.title}</h2>
          <p class="text-2xl font-bold tracking-widest">{slide.sub}</p>
          <div class="w-10 h-[1px] bg-white my-4"></div>
         
        </div>
      </div>
    ))}
  </div>

  <div class="swiper-button-prev !text-white !text-4xl md:!text-6xl after:!content-[''] font-light left-2 md:left-10 cursor-pointer z-50">‹</div>
  <div class="swiper-button-next !text-white !text-4xl md:!text-6xl after:!content-[''] font-light right-2 md:right-10 cursor-pointer z-50">›</div>
</div>
	</div>
		</section>
<style>
  @import 'swiper/css';
  @import 'swiper/css/effect-coverflow';
  @import 'swiper/css/navigation';

  .swiper-slide { transition: filter 0.3s; }
  .swiper-slide-active { filter: blur(0px); }
  .swiper-slide:not(.swiper-slide-active) { filter: blur(2px); }
</style>

<script>
  import Swiper from 'swiper';
  import { EffectCoverflow, Navigation } from 'swiper/modules';

  const swiper = new Swiper('.mySwiper', {
    modules: [EffectCoverflow, Navigation],
    effect: 'coverflow',
    grabCursor: true,
    centeredSlides: true,
    slidesPerView: 'auto',
    coverflowEffect: {
      rotate: 30,
      stretch: 0,
      depth: 200,
      modifier: 1,
      slideShadows: true,
    },
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
    loop: true,
    on: {
      init: function () {
        const activeSlide = this.slides[this.activeIndex];
        const img = activeSlide?.querySelector('img');
        if (img) {
          document.getElementById('slider-bg').style.backgroundImage = `url('${img.src}')`;
        }
      },
      slideChange: function () {
        const activeSlide = this.slides[this.activeIndex];
        const img = activeSlide?.querySelector('img');
        if (img) {
          document.getElementById('slider-bg').style.backgroundImage = `url('${img.src}')`;
        }
      }
    }
  });
</script>