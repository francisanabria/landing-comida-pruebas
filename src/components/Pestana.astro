---
// AboutTabs.astro
import Chef from './Chef.astro'
import History from './History.astro';
import Pilosophie from './Pilosophie.astro';
---

<section id="pestana" class="py-5 bg-slate-50 overflow-hidden px-4 sm:px-10 md:px-20">
  <div class="max-w-[1400px] mx-auto"> 
    
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-0 max-w-5xl mx-auto relative z-20">
      <button 
        class="tab-btn active w-full px-6 py-4 text-sm md:text-base rounded-t-[30px] sm:rounded-t-[40px] font-bold transition-all bg-emerald-700 text-white shadow-xl relative" 
        data-target="wrapper-chef">
        Unser Koch
      </button>
      
      <button 
        class="tab-btn w-full px-6 py-4 text-sm md:text-base rounded-t-[30px] sm:rounded-t-[40px] font-bold transition-all bg-slate-200 text-slate-600 hover:bg-slate-300 shadow-sm" 
        data-target="wrapper-historia">
        Geschichte
      </button>

      <button 
        class="tab-btn w-full px-6 py-4 text-sm md:text-base rounded-t-[30px] sm:rounded-t-[40px] font-bold transition-all bg-slate-200 text-slate-600 hover:bg-slate-300 shadow-sm" 
        data-target="wrapper-filosofia">
        Philosophie
      </button>
    </div>

    <div class="relative bg-white shadow-[0_20px_50px_rgba(0,0,0,0.1)] z-10 rounded-[40px] md:rounded-[60px] -mt-1">
      
      <div id="wrapper-chef" class="tab-content block animate-fade-in py-12 md:py-20 px-6 md:px-16">
        <Chef/>
      </div>
      
      <div id="wrapper-historia" class="tab-content hidden animate-fade-in py-12 md:py-20 px-6 md:px-16 bg-zinc-900 text-white rounded-[40px] md:rounded-[60px]">
        <History/>
      </div>

      <div id="wrapper-filosofia" class="tab-content hidden animate-fade-in py-12 md:py-20 px-6 md:px-16 bg-white rounded-[40px] md:rounded-[60px]">
        <Pilosophie/>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  /* Elevación suave para la pestaña activa en pantallas grandes */
  @media (min-width: 640px) {
    .tab-btn.active {
      transform: translateY(-10px);
      margin-bottom: -10px;
    }
  }

  /* Estilo base para transiciones */
  .tab-btn {
    transition: all 0.3s ease-in-out;
  }
</style>

<script>
  function setupTabNavigation() {
    const btns = document.querySelectorAll('.tab-btn');
    const contents = document.querySelectorAll('.tab-content');

    btns.forEach(btn => {
      btn.onclick = () => {
        const targetId = btn.getAttribute('data-target');

        // Limpiar todos los botones
        btns.forEach(b => {
          b.classList.remove('active', 'bg-emerald-700', 'text-white', 'shadow-xl');
          b.classList.add('bg-slate-200', 'text-slate-600');
        });

        // Activar el botón seleccionado
        btn.classList.add('active', 'bg-emerald-700', 'text-white', 'shadow-xl');
        btn.classList.remove('bg-slate-200', 'text-slate-600');

        // Alternar contenido
        contents.forEach(c => c.classList.add('hidden'));
        const target = document.getElementById(targetId);
        if (target) {
          target.classList.remove('hidden');
        }
      };
    });
  }

  // Ejecutar en carga inicial
  setupTabNavigation();
  // Ejecutar tras navegaciones de Astro (View Transitions)
  document.addEventListener('astro:after-swap', setupTabNavigation);
</script>