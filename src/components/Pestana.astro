---
import Chef from "./Chef.astro";
import Pilosophie from "./Pilosophie.astro";

// TabsAboutDE.astro
---
<section class="mx-auto max-w-5xl px-4 py-16">
  <!-- Tabs -->
  <div class="flex justify-center gap-2">
    <button
      data-tab="chef"
      class="tab-btn rounded-full px-6 py-2 text-sm font-semibold transition bg-emerald-500 text-white"
    >
      Unsere Köchin
    </button>

    <button
      data-tab="philosophie"
      class="tab-btn rounded-full px-6 py-2 text-sm font-semibold transition bg-slate-100 text-slate-600"
    >
      Philosophie
    </button>

    <button
      data-tab="geschichte"
      class="tab-btn rounded-full px-6 py-2 text-sm font-semibold transition bg-slate-100 text-slate-600"
    >
      Geschichte
    </button>
  </div>

  <!-- Content -->
  <div class="mt-10 rounded-3xl bg-white p-8 shadow-lg">
    <div id="chef" class="tab-content">
      <h3 class="mb-3 text-2xl font-bold">Unsere Köchin</h3>
      <Chef/>
    </div>

    <div id="philosophie" class="tab-content hidden">
      <h3 class="mb-3 text-2xl font-bold">Unsere Philosophie</h3>
     <Pilosophie/>
    </div>

    <div id="geschichte" class="tab-content hidden">
      <h3 class="mb-3 text-2xl font-bold">Unsere Geschichte</h3>
      <History/>
    </div>
  </div>

  <!-- Script -->
  <script is:inline>
    const buttons = document.querySelectorAll(".tab-btn");
    const contents = document.querySelectorAll(".tab-content");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        buttons.forEach((b) => {
          b.classList.remove("bg-emerald-500", "text-white");
          b.classList.add("bg-slate-100", "text-slate-600");
        });

        contents.forEach((c) => c.classList.add("hidden"));

        btn.classList.add("bg-emerald-500", "text-white");
        btn.classList.remove("bg-slate-100", "text-slate-600");

        document
          .getElementById(btn.dataset.tab)
          .classList.remove("hidden");
      });
    });
  </script>
</section>