---
// contactCard.astro
---
<section translate="yes" id="contact" class="py-0 bg-zinc-50"></section>
<div class="min-h-screen bg-slate-100 flex items-center justify-center p-4 sm:p-8 font-serif">
  <div class="bg-white rounded-[40px] shadow-2xl flex flex-col md:flex-row max-w-5xl w-full overflow-hidden relative">
    
    <div class="md:w-[45%] w-full bg-emerald-700 text-white p-10 md:p-16 relative flex flex-col justify-center overflow-visible order-1 rounded-full rounded-l-none rounded-tl-none">
      
      <div class="hidden md:block absolute top-0 -right-20 h-full w-40 bg-white/0 z-0  "></div>
      
      <div class="relative z-10 space-y-8 animate-fade-in font-serif">
        <div>
          <h2 class="text-4xl font-bold mb-4">Kontakt aufnehmen</h2>
          <p class="text-teal-100/70 text-lg leading-relaxed">
            Füllen Sie das Formular aus und wir werden uns in Kürze bei Ihnen melden.
          </p>
        </div>
      
        <div class="space-y-6">
          <div class="flex items-center space-x-4 group cursor-pointer hover:translate-x-2 transition-transform">
           <div class="bg-white/10 p-3 rounded-full group-hover:bg-teal-500 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            </div>
            <span class="font-medium">+1 (555) 123-4567</span>
          </div>

          <div class="flex items-center space-x-4 group cursor-pointer hover:translate-x-2 transition-transform">
            
            <div class="bg-white/10 p-3 rounded-full group-hover:bg-teal-500 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            </div>
            <span class="font-medium">info@beispiel.com</span>
          </div>

          <div class="flex items-center space-x-4 group cursor-pointer hover:translate-x-2 transition-transform">
            <div class="bg-white/10 p-3 rounded-full group-hover:bg-teal-500 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /></svg>
            </div>
            <span class="font-medium">Beispielstraße 123, Stadt</span>
          </div>
        </div>
      </div>
    </div>

    <div class="p-8 sm:p-10 md:p-16 md:w-[55%] w-full bg-white z-10 order-2">
      <h2 class="text-3xl font-bold text-slate-800 mb-8">Kontaktieren Sie uns</h2>
      
      <form class="space-y-1">
        <div class="relative">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
            </svg>
          </span>
          <input type="text" placeholder="Vollständiger Name" class="w-full bg-gray-100 border-none rounded-2xl py-4 pl-12 pr-4 outline-none focus:ring-2 focus:ring-teal-500/50 transition-all" />
        </div>

        <div class="relative">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
            </svg>
          </span>
          <input type="text" placeholder="Telefonnummer" class="w-full bg-gray-100 border-none rounded-2xl py-4 pl-12 pr-4 outline-none focus:ring-2 focus:ring-teal-500/50 transition-all" />
        </div>

         <div class="relative group">
          <div class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-teal-600 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
            </svg>
          </div>
          <input 
            type="email" 
            placeholder="E-Mail-Adresse" 
            class="w-full bg-gray-100 border-none rounded-2xl py-4 pl-12 pr-4 focus:ring-2 focus:ring-teal-400 outline-none transition-all" 
          />
        </div>

       
        <div class="relative group">
          <div class="absolute left-4 top-4 text-slate-400 group-focus-within:text-teal-600 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd" />
            </svg>
          </div>
          <textarea 
            rows="4" 
            placeholder="Ihre Nachricht..." 
            class="w-full bg-gray-100 border-none rounded-2xl py-4 pl-12 pr-4 focus:ring-2 focus:ring-teal-400 outline-none transition-all resize-none"
          ></textarea>
        </div>

        <button class="w-full bg-gradient-to-r from-emerald-800 to-emerald-400 text-white font-bold py-4 rounded-full shadow-lg hover:shadow-teal-500/40 transition-all duration-300 transform hover:-translate-y-1 active:scale-95">
          Nachricht senden
        </button>
        
        <p class="text-center text-xs text-slate-400 mt-2">Wir werden uns so schnell wie möglich bei Ihnen melden.</p>
      </form>
    </div>

  </div>
</div>
</section>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
  }
</style>



